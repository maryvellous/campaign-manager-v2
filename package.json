{
  "name": "campaign-manager-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "start": "npm run build && node scripts/start.mjs",
    "test": "tsx --test tests/*.test.ts",
    "lint": "eslint .",
    "test:electron": "npm run build && node scripts/smoke.mjs",
    "test:goal2": "npm run build && node scripts/goal2-smoke.mjs",
    "test:goal3": "npm run build && node scripts/goal3-smoke.mjs"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "electron": "^44.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "playwright": "^1.63.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
